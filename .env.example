# ============================================================
# Monopoli Indonesia — konfigurasi server (salin menjadi .env)
# ============================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database PostgreSQL. Untuk Supabase: Project Settings → Database → Connection string (URI, mode "Session").
# Kosongkan untuk memakai PGlite (Postgres WASM lokal di .data/pglite) — cocok untuk pengembangan.
DATABASE_URL=postgres://monopoli:monopoli@localhost:5432/monopoli
DB_POOL=10

# Origin frontend yang diizinkan (pisahkan dengan koma). Wajib diisi bila frontend dideploy terpisah (mis. Vercel).
ALLOWED_ORIGINS=https://monopoli-indonesia.vercel.app
# Set 1 bila server berada di belakang reverse proxy/load balancer (agar IP rate limit akurat).
TRUST_PROXY=1

# Akun Super Admin pertama (dibuat otomatis saat server start bila belum ada). GANTI password ini!
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Supabase Auth (opsional — mengaktifkan tombol "Masuk dengan Google").
# SUPABASE_JWT_SECRET: Project Settings → API → JWT Secret (rahasia, hanya di server).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Gameplay
TURN_SECONDS=45
DISCONNECT_GRACE_SEC=60
BOT_DELAY_MS=1100
MATCHMAKING_WAIT_SEC=12
SESSION_DAYS=30

# Rate limit (per IP / per pemain)
API_RATE=20
ACTION_RATE=6
AUTH_BURST=10

# Pembayaran uang sungguhan — sengaja NONAKTIF. Isi hanya setelah integrasi payment gateway resmi selesai (lihat docs/DEPLOYMENT.md).
PAYMENT_PROVIDER=
